{
  "name": "orbfall",
  "private": true,
  "version": "0.0.0",
  "description": "A browser game a coding agent built with DriftEngine from one prompt",
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "look": "node scripts/look.mjs",
    "check": "npm run typecheck && npm test && npm run look",
    "deploy": "npm run build && wrangler deploy"
  },
  "dependencies": {
    "@driftengine/audio": "^4.13.0",
    "@driftengine/core": "^4.13.0",
    "@driftengine/script": "^4.13.0",
    "driftscript": "1.17.0"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "vitest": "^5.0.3",
    "wrangler": "^4.149.0"
  }
}
