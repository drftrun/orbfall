// The run: how long it lasts, what a crystal is worth, what falling off costs, the best score, and
// how hard the boulders get as the clock runs down. The page owns the island, the orb and the
// boulders, and asks these rules about them.

// How long a run lasts, in seconds.
let RUN_SECONDS: f32 = 60
// How close the orb's centre has to come to a crystal's, in metres, to take it.
let REACH: f32 = 1.3
// What a crystal is worth, and what a fall off the edge takes away.
let CRYSTAL_POINTS: u32 = 1
let FALL_PENALTY: u32 = 3

// Where a run is: still being played, or over with the clock at zero.
enum Phase {
    Playing
    Over
}

// One run, which the page owns and hands to every rule below. `best` outlives a run.
data Run {
    remaining: f32 = 60
    score: u32 = 0
    best: u32 = 0
    crystals: u32 = 0
    falls: u32 = 0
    newBest: bool = false
    phase: Phase = Phase.Playing
}

// A new run: a full clock and nothing scored. The best score is kept.
fn start(run: mut Run) {
    run.remaining = RUN_SECONDS
    run.score = 0
    run.crystals = 0
    run.falls = 0
    run.newBest = false
    run.phase = Phase.Playing
}

// The best score a previous session saved, read back when the page starts.
fn restoreBest(run: mut Run, best: u32) {
    run.best = best
}

// Seconds since the run began.
@pure
fn elapsed(run: Run) -> f32 {
    return RUN_SECONDS - run.remaining
}

// Whether the orb, this far from a crystal on each axis, is close enough to take it.
@pure
fn reaches(dx: f32, dy: f32, dz: f32) -> bool {
    return dx * dx + dy * dy + dz * dz < REACH * REACH
}

// A crystal taken. Nothing counts once the clock has run out.
fn collect(run: mut Run) {
    if run.phase != Phase.Playing {
        return
    }
    run.crystals = run.crystals + 1
    run.score = run.score + CRYSTAL_POINTS
}

// The orb fell off the edge: it costs points, never below zero.
fn fall(run: mut Run) {
    if run.phase != Phase.Playing {
        return
    }
    run.falls = run.falls + 1
    run.score = run.score -| FALL_PENALTY
}

// How many boulders roll at once, by seconds into the run: two at the start, six at the end.
@pure
fn boulders(elapsed: f32) -> u32 {
    if elapsed < 8 {
        return 2
    }
    if elapsed < 20 {
        return 3
    }
    if elapsed < 32 {
        return 4
    }
    if elapsed < 45 {
        return 5
    }
    return 6
}

// How hard a boulder is shoved toward the orb, in metres per second squared, rising with the clock.
@pure
fn boulderPush(elapsed: f32) -> f32 {
    return 4 + elapsed * 0.07
}

// The fastest a boulder is shoved to, in metres per second, rising with the clock.
@pure
fn boulderTopSpeed(elapsed: f32) -> f32 {
    return 5 + elapsed * 0.06
}

// The clock, once a step. At zero the run is over, and a score above the best becomes the best.
@deterministic
fn tick(run: mut Run, dt: f32) {
    if run.phase != Phase.Playing {
        return
    }
    run.remaining = run.remaining - dt
    if run.remaining <= 0 {
        run.remaining = 0
        run.phase = Phase.Over
        if run.score > run.best {
            run.best = run.score
            run.newBest = true
        }
    }
}
